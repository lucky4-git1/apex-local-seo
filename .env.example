# ==============================================================================
# LOCAL SEO & GOOGLE BUSINESS PROFILE OPERATIONS PLATFORM
# Environment Configuration Template
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# Default: uses native built-in SQLite file storage in ./data/local_seo.db (zero setup required)
# Or provide a PostgreSQL connection string:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/local_seo_db
DATABASE_PATH=./data/local_seo.db

# Mode Configuration
# When set to true, realistic Google Business Profile & Geo-Grid demo fixtures are active
# without requiring production Google Cloud OAuth approval.
DEMO_MODE=true

# Google Cloud & Google Business Profile API OAuth 2.0 Credentials
# Required for live synchronization with Google Business Profile APIs:
# 1. Google My Business Business Information API v1
# 2. Google Business Profile Performance API v1
# 3. Google My Business Account Management API
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/v1/auth/google/callback
GOOGLE_SCOPES=https://www.googleapis.com/auth/business.manage

# AI Model Provider Configuration
# Supported providers: 'mock' (instant deterministic local responses), 'gemini', or 'openai'
AI_PROVIDER=mock
GEMINI_API_KEY=your-gemini-api-key
OPENAI_API_KEY=your-openai-api-key

# Client Application URL
CLIENT_URL=http://localhost:3000

# Security & Session
SESSION_SECRET=local-seo-platform-secure-jwt-session-secret-change-in-prod
